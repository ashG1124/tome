# 복사해서 `.env`로 사용한다: cp .env.example .env  (.env 는 커밋하지 않는다)

# 로컬 개발용 Postgres(루트 docker-compose.yml 의 db). 로컬 개발용이며 비밀이 아니다.
DATABASE_URL=postgresql://tome:tome@localhost:55433/tome?schema=public
# 마이그레이션 전용 직접 연결 주소(선택). 비우면 DATABASE_URL 을 쓴다.
DIRECT_DATABASE_URL=
PORT=3000
# mock(고정 응답, 비용 0) 또는 workers-ai(Cloudflare Workers AI)
AI_PROVIDER=mock
# AI_PROVIDER=workers-ai 일 때 둘 다 필요하다. 실제 값은 .env 에만 둔다(배포는 wrangler secret put).
WORKERS_AI_ACCOUNT_ID=
WORKERS_AI_API_TOKEN=
# 브라우저 출처 허용(쉼표로 여러 개)
CORS_ORIGIN=http://localhost:5173
# 응답의 version 에 넣을 값(선택)
APP_VERSION=
# 관리 API(X-Admin-Token) 토큰. 비우면 관리 API 는 쓸 수 없다. 실제 값은 .env 에만 둔다.
ADMIN_TOKEN=

# 이미지 저장소: local(파일, 기본) 또는 r2(Cloudflare R2)
STORAGE_DRIVER=local
# local 저장 폴더(선택). 비우면 apps/server/.storage
STORAGE_LOCAL_DIR=
# local 서명 키(선택). 비우면 서버를 켤 때마다 새로 만든다.
STORAGE_LOCAL_SECRET=
# STORAGE_DRIVER=r2 일 때 네 개 모두 필요하다. 실제 값은 .env 에만 둔다.
R2_ENDPOINT=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# 이미지 서명 URL 수명(초, 30~3600)
ASSET_URL_TTL_SECONDS=300
