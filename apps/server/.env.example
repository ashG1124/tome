# 복사해서 `.env`로 사용한다: cp .env.example .env  (.env 는 커밋하지 않는다)

# 로컬 개발용 Postgres(루트 docker-compose.yml 의 db). 로컬 개발용이며 비밀이 아니다.
DATABASE_URL=postgresql://tome:tome@localhost:55433/tome?schema=public
# 마이그레이션 전용 직접 연결 주소(선택). 비우면 DATABASE_URL 을 쓴다.
DIRECT_DATABASE_URL=
PORT=3000
# 지금은 mock 만 지원한다.
AI_PROVIDER=mock
# 브라우저 출처 허용(쉼표로 여러 개)
CORS_ORIGIN=http://localhost:5173
# 응답의 version 에 넣을 값(선택)
APP_VERSION=
