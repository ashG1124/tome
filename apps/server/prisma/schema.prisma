// Prisma 7: 연결 주소는 schema 가 아니라 prisma.config.ts 에서 읽는다.
generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// ---- 마이그레이션 1: access ----

enum CreatorKind {
  seed
  persona
  visitor
}

enum AccessTarget {
  visitor_pool
  creator
}

model Creator {
  id             String      @id @default(uuid(7)) @db.Uuid
  kind           CreatorKind
  displayName    String      @db.VarChar(40)
  bio            String?     @db.VarChar(120)
  avatarKey      String?
  identityPublic Boolean     @default(true)
  seedOrder      Int?        @unique
  createdAt      DateTime    @default(now()) @db.Timestamptz(3)

  accessCodes     AccessCode[]
  sessions        DemoSession[]
  consents        ConsentRecord[]
  projects        Project[]       @relation("ProjectOwner")
  remixedProjects Project[]       @relation("ProjectRemixPartner")

  @@index([kind])
}

// target='creator' 일 때만 creatorId 가 있어야 한다(CHECK 는 마이그레이션 SQL 에 직접 있다).
model AccessCode {
  id        String       @id @default(uuid(7)) @db.Uuid
  label     String
  codeHash  String
  target    AccessTarget
  creatorId String?      @db.Uuid
  active    Boolean      @default(true)
  createdAt DateTime     @default(now()) @db.Timestamptz(3)

  creator  Creator?      @relation(fields: [creatorId], references: [id], onDelete: Restrict)
  sessions DemoSession[]
}

model DemoSession {
  id           String    @id @default(uuid(7)) @db.Uuid
  tokenHash    String    @unique
  creatorId    String    @db.Uuid
  accessCodeId String    @db.Uuid
  ipHash       String?
  userAgent    String?   @db.VarChar(200)
  createdAt    DateTime  @default(now()) @db.Timestamptz(3)
  lastSeenAt   DateTime  @default(now()) @db.Timestamptz(3)
  expiresAt    DateTime  @db.Timestamptz(3)
  revokedAt    DateTime? @db.Timestamptz(3)

  creator    Creator         @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  accessCode AccessCode      @relation(fields: [accessCodeId], references: [id], onDelete: Restrict)
  consents   ConsentRecord[]
  jobs       GenerationJob[]

  @@index([creatorId])
}

model ConsentRecord {
  id            String   @id @default(uuid(7)) @db.Uuid
  sessionId     String   @db.Uuid
  creatorId     String   @db.Uuid
  noticeVersion String
  agreedAt      DateTime @default(now()) @db.Timestamptz(3)

  session DemoSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  creator Creator     @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  @@unique([sessionId, noticeVersion])
}

model AppSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
}

model IdempotencyRecord {
  sessionId   String   @db.Uuid
  key         String
  route       String
  requestHash String
  statusCode  Int
  response    Json
  createdAt   DateTime @default(now()) @db.Timestamptz(3)

  @@id([sessionId, key])
  @@index([createdAt])
}

// ---- 마이그레이션 2: workspace ----

enum ProjectKind {
  original
  derive
}

enum ProjectStatus {
  building
  finished
}

enum AnswerStatus {
  draft
  accepted
  discarded
}

enum AnswerOrigin {
  generated
  edited
  sample
  derived_copy
  seed
}

enum ImageMode {
  generate
  edit
}

enum JobKind {
  create
  revise
}

enum JobStatus {
  pending
  running
  succeeded
  failed
  cancelled
}

enum StepStatus {
  pending
  running
  succeeded
  failed
  skipped
}

// remixPartnerSnapshotId · topicId 는 해당 표가 생기는 뒤 단계 마이그레이션에서 컬럼을 추가한다.
model Project {
  id                   String        @id @default(uuid(7)) @db.Uuid
  ownerId              String        @db.Uuid
  kind                 ProjectKind
  title                String        @db.VarChar(60)
  status               ProjectStatus @default(building)
  finishedAt           DateTime?     @db.Timestamptz(3)
  postedAt             DateTime?     @db.Timestamptz(3)
  coverAnswerId        String?       @db.Uuid
  selectionReason      String?       @db.VarChar(300)
  derivedFromProjectId String?       @db.Uuid
  derivedFromAnswerId  String?       @db.Uuid
  remixPartnerId       String?       @db.Uuid
  shelfPosition        Int
  lastEditedAt         DateTime      @default(now()) @db.Timestamptz(3)
  createdAt            DateTime      @default(now()) @db.Timestamptz(3)
  deletedAt            DateTime?     @db.Timestamptz(3)
  hiddenAt             DateTime?     @db.Timestamptz(3)

  owner             Creator   @relation("ProjectOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  remixPartner      Creator?  @relation("ProjectRemixPartner", fields: [remixPartnerId], references: [id], onDelete: SetNull)
  coverAnswer       Answer?   @relation("ProjectCover", fields: [coverAnswerId], references: [id], onDelete: SetNull)
  derivedFromAnswer Answer?   @relation("ProjectDerivedFromAnswer", fields: [derivedFromAnswerId], references: [id], onDelete: SetNull)
  derivedFrom       Project?  @relation("ProjectDerivation", fields: [derivedFromProjectId], references: [id], onDelete: SetNull)
  derivatives       Project[] @relation("ProjectDerivation")
  pages             Page[]
  sets              PromptSet[]
  jobs              GenerationJob[]

  @@index([ownerId, deletedAt, shelfPosition])
  @@index([derivedFromProjectId])
}

// index 0~9 CHECK 는 마이그레이션 SQL 에 직접 있다.
model Page {
  id        String   @id @default(uuid(7)) @db.Uuid
  projectId String   @db.Uuid
  index     Int
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  project Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sets    PromptSet[]

  @@unique([projectId, index])
}

// position 1~3 CHECK 는 마이그레이션 SQL 에 직접 있다. attachmentId 는 뒤 단계에서 추가한다.
model PromptSet {
  id        String   @id @default(uuid(7)) @db.Uuid
  projectId String   @db.Uuid
  pageId    String   @db.Uuid
  position  Int      @db.SmallInt
  prompt    String   @db.VarChar(500)
  presetKey String?
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  project Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  page    Page            @relation(fields: [pageId], references: [id], onDelete: Cascade)
  answers Answer[]
  jobs    GenerationJob[]

  @@unique([pageId, position])
  @@index([projectId])
}

// (setId, number) 부분 유니크(number 가 있을 때만)는 마이그레이션 SQL 에 직접 있다.
model Answer {
  id                 String       @id @default(uuid(7)) @db.Uuid
  setId              String       @db.Uuid
  status             AnswerStatus
  number             Int?
  baseAnswerId       String?      @db.Uuid
  jobId              String?      @db.Uuid
  origin             AnswerOrigin
  imageKey           String
  thumbKey           String?
  editInputKey       String?
  imageMode          ImageMode
  editInstruction    String?
  assembledPrompt    String       @db.VarChar(2048)
  phrases            Json
  excluded           Json
  nodes              Json
  verification       Json?
  provider           String
  model              String
  isSample           Boolean      @default(false)
  sampleResultId     String?      @db.Uuid
  copiedFromAnswerId String?      @db.Uuid
  pinned             Boolean      @default(false)
  createdById        String       @db.Uuid
  createdAt          DateTime     @default(now()) @db.Timestamptz(3)

  set              PromptSet     @relation(fields: [setId], references: [id], onDelete: Cascade)
  baseAnswer       Answer?       @relation("AnswerEditChain", fields: [baseAnswerId], references: [id], onDelete: SetNull)
  editedAnswers    Answer[]      @relation("AnswerEditChain")
  copiedFrom       Answer?       @relation("AnswerCopy", fields: [copiedFromAnswerId], references: [id], onDelete: SetNull)
  copies           Answer[]      @relation("AnswerCopy")
  sampleResult     SampleResult? @relation(fields: [sampleResultId], references: [id], onDelete: SetNull)
  coverOf          Project[]     @relation("ProjectCover")
  derivedProjects  Project[]     @relation("ProjectDerivedFromAnswer")

  @@index([setId, pinned])
}

// 같은 프로젝트에 pending·running 인 job 은 하나만(부분 유니크는 마이그레이션 SQL 에 직접 있다).
model GenerationJob {
  id                   String    @id @default(uuid(7)) @db.Uuid
  projectId            String    @db.Uuid
  setId                String    @db.Uuid
  kind                 JobKind
  baseAnswerId         String?   @db.Uuid
  requestedNodes       Json?
  appliedConnectionIds String[]  @db.Uuid
  startStage           String
  nextStage            String?
  status               JobStatus @default(pending)
  resultAnswerId       String?   @db.Uuid
  errorCode            String?
  idempotencyKey       String
  createdBySessionId   String    @db.Uuid
  ipHash               String?
  createdAt            DateTime  @default(now()) @db.Timestamptz(3)
  finishedAt           DateTime? @db.Timestamptz(3)

  project Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  set     PromptSet   @relation(fields: [setId], references: [id], onDelete: Cascade)
  session DemoSession @relation(fields: [createdBySessionId], references: [id], onDelete: Cascade)
  steps   JobStep[]

  @@unique([createdBySessionId, idempotencyKey])
  @@index([createdBySessionId, createdAt])
}

model JobStep {
  id           String     @id @default(uuid(7)) @db.Uuid
  jobId        String     @db.Uuid
  stage        String
  status       StepStatus @default(pending)
  attempt      Int        @default(0) @db.SmallInt
  leaseUntil   DateTime?  @db.Timestamptz(3)
  provider     String?
  model        String?
  fallbackUsed Boolean    @default(false)
  latencyMs    Int?
  neuronsEst   Decimal?   @db.Decimal(12, 4)
  errorCode    String?
  output       Json?
  startedAt    DateTime?  @db.Timestamptz(3)
  finishedAt   DateTime?  @db.Timestamptz(3)

  job GenerationJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([jobId, stage])
}

model UsageDaily {
  date          DateTime @id @db.Date
  textCalls     Int      @default(0)
  imageCount    Int      @default(0)
  fallbackCount Int      @default(0)
  neuronsEst    Decimal  @default(0) @db.Decimal(14, 4)
  costUsdEst    Decimal  @default(0) @db.Decimal(10, 4)
}

model SampleResult {
  id             String   @id @default(uuid(7)) @db.Uuid
  scenarioKey    String   @unique
  title          String
  promptVariants Json
  nodes          Json
  verification   Json?
  imageKey       String
  thumbKey       String
  createdAt      DateTime @default(now()) @db.Timestamptz(3)

  answers Answer[]
}
