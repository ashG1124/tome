{
  "name": "@tome/server",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "prisma generate && nest build",
    "start": "node dist/main.js",
    "start:dev": "prisma generate && nest start --watch",
    "typecheck": "prisma generate && tsc -p tsconfig.json --noEmit && tsc -p worker/tsconfig.json",
    "deploy": "wrangler deploy",
    "test": "vitest run",
    "test:watch": "vitest",
    "prisma:generate": "prisma generate",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "db:seed": "prisma generate && tsc -p tsconfig.seed.json && node dist/seed-build/prisma/seed/seed.js",
    "check:pooled": "prisma generate && tsc -p tsconfig.seed.json && node dist/seed-build/scripts/check-pooled.js"
  },
  "dependencies": {
    "@nestjs/common": "~12.2.0",
    "@nestjs/core": "~12.2.0",
    "@nestjs/platform-express": "~12.2.0",
    "@prisma/adapter-pg": "~7.10.1",
    "@prisma/client": "~7.10.1",
    "@tome/shared": "workspace:*",
    "aws4fetch": "^1.0.20",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "~4.6.7"
  },
  "devDependencies": {
    "@cloudflare/containers": "~0.3.7",
    "@cloudflare/workers-types": "~5.20261102.1",
    "@nestjs/cli": "~12.0.11",
    "@nestjs/testing": "~12.2.0",
    "@swc/core": "^1.16.20",
    "@types/express": "^5.0.6",
    "@types/node": "~22.20.5",
    "@types/pg": "^8.23.1",
    "prisma": "~7.10.1",
    "typescript": "~6.0.3",
    "unplugin-swc": "^2.0.0",
    "vitest": "~4.1.12",
    "wrangler": "~4.156.2"
  }
}
