{
  "name": "tome",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "TOME monorepo",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=22.22.0 <23"
  },
  "scripts": {
    "preinstall": "node scripts/only-pnpm.mjs",
    "prepare": "node scripts/install-git-hooks.mjs",
    "build": "pnpm -r --if-present build",
    "test": "pnpm test:repo && pnpm -r --if-present test",
    "test:repo": "node --test scripts/*.test.mjs",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "design:check": "pnpm --filter @tome/client --if-present design:check",
    "test:e2e": "pnpm --filter @tome/client --if-present test:e2e"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "~22.20.5",
    "eslint": "~10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.14.0",
    "prettier": "~3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "~8.72.1"
  }
}
